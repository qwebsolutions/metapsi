<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFrameworks>net8.0;net47</TargetFrameworks>
		<LangVersion>11.0</LangVersion>
		<IsPackable>true</IsPackable>
		<Description>Adds Metapsi HTTP support for serving HTML, CSS, JavaScript and embedded resources</Description>
		<IncludeSource>true</IncludeSource>
		<EmbedAllSources>true</EmbedAllSources>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<Compile Remove="netframework\**\*.cs" />
		<None Include="netframework\**\*.cs" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
		<EmbeddedResource Include="net\embedded\signalr.js" LogicalName="signalr.js" />
		<EmbeddedResource Include="net\embedded\metapsi-signalr.js" LogicalName="metapsi-signalr.js" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net47'))">
		<Compile Remove="net\**\*.cs" />
		<None Include="net\**\*.cs" />
		<Reference Include="System.Web" />
		<EmbeddedResource Include="netframework\embedded\signalr-no-jquery@0.2.1.js" LogicalName="signalr-no-jquery@0.2.1.js" />
		<EmbeddedResource Include="netframework\embedded\jquery-deferred@0.3.1.js" LogicalName="jquery-deferred@0.3.1.js" />
		<EmbeddedResource Include="netframework\embedded\jquery-param@0.2.0.js" LogicalName="jquery-param@0.2.0.js" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Metapsi.Module\Metapsi.Module.csproj" />
		<ProjectReference Include="..\Metapsi.Html\Metapsi.Html.csproj" />
	</ItemGroup>

</Project>
