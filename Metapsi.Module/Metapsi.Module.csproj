<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net47</TargetFrameworks>
		<LangVersion>8.0</LangVersion>
		<OutputType>Library</OutputType>
		<IncludeSource>true</IncludeSource>
		<EmbedAllSources>true</EmbedAllSources>
		<Description>The base package for building client-side web pages in C# with Metapsi. Allows defining abstract logic that gets converted to JavaScript.</Description>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="embedded\uuid.js" LogicalName="uuid.js" />
		<EmbeddedResource Include="embedded\linq.js" LogicalName="linq.js" />
		<EmbeddedResource Include="embedded\metapsi.core.js" LogicalName="metapsi.core.js" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.IO.Hashing" Version="8.0.0" />
		
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<Compile Remove="netframework\**\*.cs" />
		<None Include="netframework\**\*.cs" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net47'))">
		<Compile Remove="net\**\*.cs" />
		<None Include="net\**\*.cs" />
	</ItemGroup>

</Project>
